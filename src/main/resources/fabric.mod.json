{
  "schemaVersion": 1,
  "id": "sigil",
  "version": "${version}",
  "name": "Sigil",
  "description": "Library for creating server-side skills",
  "authors": [
    "Zuttomae"
  ],
  "license": "Apache-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.zuttomae.sigil.impl.skill.SkillEntrypoint"
    ]
  },
  "mixins": [
    "sigil.mixins.json"
  ],
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1309": [
        "org/zuttomae/sigil/api/skill/entity/SkillEntity"
      ]
    }
  },
  "depends": {
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}"
  }
}
